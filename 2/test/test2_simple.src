int fibonacci(int n) {
    int a;
    int b;
    int temp;
    int i;
    
    a = 0;
    b = 1;
    i = 0;
    
    while (i < n) {
        temp = a + b;
        a = b;
        b = temp;
        i = i + 1;
    }
}

int sum_values(int size) {
    int sum;
    int i;
    
    sum = 0;
    i = 0;
    
    while (i < size) {
        sum = sum + i;
        i = i + 1;
    }
}