// Главный цикл калькулятора
void writeByte(byte b);
byte readByte();

void main() {
    int acc = 0;
    byte op;
    byte digit;
    int operand;
    byte zero = "0";

    while (1) {
        writeByte(12 + zero);
        writeByte(acc + zero);
        op = readByte();    // Считываем оператор
        digit = readByte(); // Считываем цифру

        // Преобразуем символ цифры в числовое значение (например '5' -> 5)
        operand = digit - zero;

        // Выполняем операцию в зависимости от оператора
        if (op == "+") {
            acc = acc + operand;
        }
        if (op == "-") {
            acc = acc - operand;
        }
        if (op == "*") {
            acc = acc * operand;
        }
        if (op == "/") {
            acc = acc / operand;
        }
        if (op == zero) {
            break;
        }
    }
}