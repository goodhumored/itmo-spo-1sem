int main(int argc, char[][] argv)
{
	printf("1");

	while(1)
	{
		printf("2");

		while(2)
		{
			printf("3");

			if(3)
				printf("break\n");
			else if (4)
				printf("continue\n");
			else
			{
				printf("labb:\n");
				printf("4");
			}
		}

		printf("5");
		if(5)
			printf("break\n");
		else if (6)
			printf("continue\n");
		else
			printf("6");

		printf("7");

		do
		{
			printf("8");
			if (9)
				printf("break\n");
		} while(10);

		printf("11");

		if(11)
			printf("break\n");
		else if (12)
			printf("continue\n");
		else
		{
			printf("12");
			printf("goto labb\n");
		}

		printf("13");

	}

	printf("14");
}
