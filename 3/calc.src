void writeByte(byte b);
byte readByte();
int fib(int n);

void main() {
    int acc = 0;
    byte op;
    byte digit;
    int operand;
    byte zero = "0";

    while (1) {
        writeByte(12 + zero);
        writeByte(acc + zero);
        op = readByte();    // Считываем оператор
        digit = readByte(); // Считываем цифру

        // Преобразуем символ цифры в числовое значение (например '5' -> 5)
        operand = digit - zero;

        // Выполняем операцию в зависимости от оператора
        if (op == "+") {
          acc = acc + operand;
        }
        if (op == "-") {
          acc = acc - operand;
        }
        if (op == "*") {
          acc = acc * operand;
        }
        if (op == "/") {
          acc = acc / operand;
        }
        if (op == "f") {
          acc = fib(operand);
        }
        if (op == zero) {
          break;
        }
    }
}

int fib(int n) {
  int r;
  if (n<3) {
    r = 1;
  } else {
    r = fib(n-2);
    r = r + fib(n-1);
  }
  return r;
}

