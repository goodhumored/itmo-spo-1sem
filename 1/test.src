int add(int a, int b) {
    int result;
    result = a + b;
}

int main() {
    int x, y;
    x = 5;
    y = 10;
    int sum;
    sum = add(x, y);

    if (sum > 0) {
        sum = sum * 2;
    } else {
        sum = 0;
    }

    while (sum > 0) {
        sum = sum - 1;
        if (sum < 5) {
            break;
        }
    }
}
